#!/usr/bin/env bash

: "${MECHASHIP_VARIANT:=uipa}"

if [[ ! "${MECHASHIP_VARIANT}" =~ ^[a-z0-9_-]+$ ]]; then
	echo "Invalid MECHASHIP_VARIANT=${MECHASHIP_VARIANT}" >&2
	exit 1
fi

userpatches_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
variant_config="${userpatches_dir}/overlay/mechaship/config/variants/${MECHASHIP_VARIANT}.conf"

if [[ ! -f "${variant_config}" ]]; then
	echo "Unknown MECHASHIP_VARIANT=${MECHASHIP_VARIANT}" >&2
	echo "Missing variant config: ${variant_config}" >&2
	exit 1
fi

source "${variant_config}"

# Prefix generated image filenames with the MechaShip product identifier.
# Example: mechaship_uipa_24.11.1_Rock-5a_noble_vendor_6.1.75.img
VENDOR="mechaship_${MECHASHIP_VARIANT}"

# Configure the image timezone through Armbian's rootfs setup.
TZDATA="Asia/Seoul"

# Use the host's active DNS server inside the build chroot. Prefer the
# systemd-resolved upstream resolver file over the local 127.0.0.53 stub.
if [[ -z "${NAMESERVER:-}" ]]; then
	for resolv_conf in /run/systemd/resolve/resolv.conf /etc/resolv.conf; do
		if [[ -r "${resolv_conf}" ]]; then
			NAMESERVER="$(awk '/^nameserver[[:space:]]+/ && $2 !~ /^127\./ { print $2; exit }' "${resolv_conf}")"
			[[ -n "${NAMESERVER}" ]] && break
		fi
	done
fi

# Keep users and files created under /home by customize-image.sh in the final image.
INCLUDE_HOME_DIR=yes

# Disable Armbian's default root console autologin. MechaShip configures
# console autologin for MECHASHIP_USER from customize-image.sh instead.
CONSOLE_AUTOLOGIN=no

# MechaShip images are fully provisioned by customize-image.sh, so the
# interactive Armbian configuration utility is not needed.
PACKAGE_LIST_RM="${PACKAGE_LIST_RM:-} armbian-config"
remove_packages armbian-config
